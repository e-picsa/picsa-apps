# Template for apps/picsa-server/.env.server (this file is committed, values are placeholders)
# Copy to .env.server and fill in real values:
#   cp .env.server.example .env.server
# .env.server is gitignored - never commit real keys.
#
# Find keys in Supabase Dashboard → Settings → API:
# - Publishable key  (sb_publishable_...) - safe for client apps, RLS-enforced
# - Secret key        (sb_secret_...)      - bypasses RLS, server-side only
# Legacy anon / service_role JWTs are also accepted as fallbacks.

SUPABASE_REMOTE_URL=https://<project-ref>.supabase.co

# Recommended: secret key. Required for full seed export - most seed tables
# revoke anon access and budget.budgets + geo.countries/locales are only
# readable with the secret key (see scripts/utils/supabase.utils.ts).
SUPABASE_REMOTE_SECRET_KEY=<sb-secret-key>

# Optional fallback: publishable key. Export will run but RLS will block most
# seed tables (expect 0-row CSVs except RLS-open tables). Prefer secret key.
# SUPABASE_REMOTE_PUBLISHABLE_KEY=<sb-publishable-key>
