{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ESNext",
    "types": ["node"],
    "importHelpers": false
  },
  // Covers Node-run scripts. supabase/functions is intentionally excluded -
  // edge functions target the Deno runtime (remote imports, Deno globals)
  // and are verified via `deno check` / test-functions instead.
  "include": ["scripts/**/*.ts"]
}
