# Environment variables for PICSA scripts and AI triage
EXAMPLE_VAR=hello

# Sentry API Configuration (for yarn ai:triage)
# Create a user auth token with 'project:read, org:read, event:read' at: https://e-picsa.sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://e-picsa.sentry.io
# SENTRY_ORG=e-picsa         # optional, auto-detected from token if omitted
# SENTRY_PROJECT=picsa-apps  # optional, auto-detected from token if omitted

# Firebase Crashlytics Configuration (for yarn ai:triage)
# If BigQuery integration is enabled in Firebase Console (https://console.firebase.google.com/project/picsa-apps/settings/integrations)
FIREBASE_PROJECT_ID=picsa-apps
